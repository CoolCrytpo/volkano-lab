---
import { siteConfig } from '../config/site.config';
---

<section class="py-24 relative overflow-hidden bg-volkano-dark">
  <div class="absolute inset-0 bg-grid-pattern-dark opacity-15"></div>
  <div class="absolute top-0 right-1/4 w-[600px] h-[400px] bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-volkano-orange/20 via-transparent to-transparent pointer-events-none"></div>

  <div class="container relative z-10 mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <!-- Left: Copy -->
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-volkano-orange/10 border border-volkano-orange/20 text-volkano-orange text-xs font-bold uppercase tracking-widest mb-6">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-volkano-orange opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-volkano-orange"></span>
            </span>
            Restez informé
          </div>

          <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-6 leading-tight">
            La veille tech qui vous fait
            <span class="text-volkano-orange"> gagner du temps.</span>
          </h2>

          <p class="text-white/60 text-lg mb-8 leading-relaxed">
            Analyses, outils et guides actionnables sur l'IA, la crypto et l'automatisation — directement dans votre boîte mail. Sans spam. Sans bruit.
          </p>

          <div class="flex flex-wrap gap-4 text-sm text-white/40">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-volkano-orange" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Sans spam
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-volkano-orange" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Conforme RGPD
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-volkano-orange" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Désabonnement en 1 clic
            </span>
          </div>
        </div>

        <!-- Right: Email Form -->
        <div class="bg-white/5 border border-white/10 rounded-3xl p-8 backdrop-blur-sm">
          <h3 class="font-display font-bold text-xl text-white mb-2">
            Rejoindre la newsletter
          </h3>
          <p class="text-white/50 text-sm mb-6">
            Prochaine édition : outils IA pour entrepreneurs
          </p>

          <form
            action={`mailto:${siteConfig.email}?subject=Inscription newsletter`}
            method="get"
            class="space-y-4"
            id="newsletter-form"
          >
            <div>
              <label for="email-input" class="block text-sm font-medium text-white/70 mb-2">
                Votre adresse email
              </label>
              <input
                type="email"
                id="email-input"
                name="email"
                placeholder="vous@exemple.com"
                required
                class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-volkano-orange focus:border-transparent transition-all"
              />
            </div>

            <button
              type="submit"
              class="w-full btn-primary justify-center text-base py-3.5"
            >
              S'inscrire gratuitement
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </button>
          </form>

          <p class="mt-4 text-center text-xs text-white/30">
            En vous inscrivant, vous acceptez de recevoir des emails de Volkano Lab.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
