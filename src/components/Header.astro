---
import { siteConfig } from '../config/site.config';

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-lg border-b border-gray-100 transition-all duration-300">
  <nav class="container mx-auto px-4">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3 group shrink-0">
        <div class="w-10 h-10 bg-volkano-dark rounded-xl flex items-center justify-center transform group-hover:rotate-12 transition-transform duration-300 shadow-md">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L6 15h4l-1 7 7-10h-4l2-10z" fill="#F39C12" stroke="#F39C12" stroke-width="0.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <div class="font-display font-bold text-xl leading-none text-volkano-dark tracking-tight">{siteConfig.siteName}</div>
          <div class="text-[10px] uppercase tracking-[0.2em] font-medium text-gray-400 mt-1">{siteConfig.tagline}</div>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-1">
        {siteConfig.navigation.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
                isActive
                  ? 'text-volkano-orange bg-volkano-orange/8'
                  : 'text-gray-600 hover:text-volkano-dark hover:bg-gray-50'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </div>

      <!-- Contact Button & Mobile Button -->
      <div class="flex items-center gap-3">
        <!-- Contact dropdown -->
        <div class="relative group hidden sm:block">
          <a
            href={`mailto:${siteConfig.email}`}
            class="btn-primary !py-2 !px-5 text-sm"
          >
            Contact
          </a>
        </div>

        <!-- Mobile menu toggle -->
        <button
          id="mobile-menu-button"
          class="md:hidden p-2.5 rounded-xl text-gray-700 hover:text-volkano-orange hover:bg-gray-50 transition-all duration-200"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div
      id="mobile-menu"
      class="hidden md:hidden pb-6 space-y-1 border-t border-gray-100 pt-4 animate-fade-in"
    >
      {siteConfig.navigation.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`block py-3 px-4 rounded-xl font-medium transition-all duration-200 text-sm ${
              isActive
                ? 'bg-volkano-orange/10 text-volkano-orange'
                : 'text-gray-700 hover:bg-gray-50 hover:text-volkano-dark'
            }`}
          >
            {item.name}
          </a>
        );
      })}
      <div class="pt-2">
        <a
          href={`mailto:${siteConfig.email}`}
          class="block py-3 px-4 rounded-xl font-medium text-sm text-center btn-primary"
        >
          Contactez-moi
        </a>
      </div>
    </div>
  </nav>
</header>

<!-- Spacer -->
<div class="h-20"></div>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  mobileMenuButton?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');

    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    } else {
      mobileMenu?.classList.remove('hidden');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'true');
    }
  });

  // Close menu when clicking a nav link (for SPA-like feel)
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
