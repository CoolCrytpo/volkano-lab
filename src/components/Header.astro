---
import { siteConfig } from '../config/site.config';

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-lg border-b border-gray-100">
  <nav class="container mx-auto px-4">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3 group">
        <div class="w-10 h-10 bg-volkano-dark rounded-xl flex items-center justify-center transform group-hover:rotate-12 transition-transform">
          <span class="text-2xl">🌋</span>
        </div>
        <div class="flex flex-col">
          <div class="font-display font-bold text-xl leading-none text-volkano-dark tracking-tight">{siteConfig.siteName}</div>
          <div class="text-[10px] uppercase tracking-[0.2em] font-medium text-gray-400 mt-1">{siteConfig.tagline}</div>
        </div>
      </a>
      
      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        {siteConfig.navigation.map((item) => (
          <a
            href={item.href}
            class={`text-sm font-medium transition-colors hover:text-volkano-orange ${
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'text-volkano-orange'
                : 'text-gray-600'
            }`}
          >
            {item.name}
          </a>
        ))}
      </div>

      <!-- Contact & Mobile Button -->
      <div class="flex items-center gap-4">
        <div class="relative group hidden sm:block">
          <button class="btn-primary !py-2 !px-5 text-sm">
            Contact
          </button>
          <div class="absolute right-0 mt-2 w-48 bg-white rounded-2xl shadow-xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-right scale-95 group-hover:scale-100 p-2">
            <a href={`mailto:${siteConfig.email}`} class="flex items-center gap-3 p-3 hover:bg-gray-50 rounded-xl transition-colors">
              <span class="text-lg">✉️</span>
              <span class="text-sm font-medium">Email</span>
            </a>
            <div class="flex items-center gap-3 p-3 opacity-50 cursor-not-allowed">
              <span class="text-lg">💬</span>
              <span class="text-sm font-medium">WhatsApp</span>
            </div>
          </div>
        </div>
        
        <button
          id="mobile-menu-button"
          class="md:hidden p-2 text-gray-700 hover:text-volkano-orange transition-colors"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
    
    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden pb-6 space-y-2 animate-fade-in">
      {siteConfig.navigation.map((item) => (
        <a
          href={item.href}
          class={`block py-3 px-4 rounded-xl font-medium transition-colors ${
            currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
              ? 'bg-volkano-orange/10 text-volkano-orange'
              : 'text-gray-700 hover:bg-gray-50'
          }`}
        >
          {item.name}
        </a>
      ))}
      <a href={`mailto:${siteConfig.email}`} class="block py-3 px-4 rounded-xl font-medium text-volkano-orange bg-volkano-orange/10">
        Contactez-moi
      </a>
    </div>
  </nav>
</header>
<div class="h-20"></div>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  
  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
