---
---

<section class="relative overflow-hidden bg-white pt-16 pb-24 md:pt-24 md:pb-32">
  <!-- Background patterns -->
  <div class="absolute inset-0 bg-grid-pattern opacity-100"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-volkano-orange/5 via-transparent to-transparent"></div>

  <div class="container relative z-10 mx-auto px-4">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-volkano-orange/10 border border-volkano-orange/20 text-volkano-orange text-xs font-bold uppercase tracking-wider mb-8 animate-fade-in">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-volkano-orange opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-volkano-orange"></span>
        </span>
        Laboratoire indépendant d'exploration tech
      </div>
      
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-display font-bold text-volkano-dark tracking-tight mb-8 animate-slide-up">
        Transformer la <span class="text-volkano-orange">complexité</span> en levier.
      </h1>
      
      <p class="text-lg md:text-xl text-gray-600 mb-12 max-w-2xl mx-auto leading-relaxed animate-slide-up [animation-delay:200ms]">
        Exploration, structuration et vulgarisation en <span class="font-semibold text-volkano-dark">IA</span>, <span class="font-semibold text-volkano-dark">crypto</span>, <span class="font-semibold text-volkano-dark">automatisation</span> et outils numériques.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up [animation-delay:400ms]">
        <a href="/decrypter" class="btn-primary w-full sm:w-auto group">
          Explorer les articles
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a href="/outils" class="btn-secondary w-full sm:w-auto">
          Voir les outils
        </a>
      </div>

      <div class="mt-20 grid grid-cols-1 sm:grid-cols-3 gap-8 max-w-3xl mx-auto animate-fade-in [animation-delay:600ms]">
        <div class="flex flex-col items-center gap-2">
          <span class="text-2xl">⭐</span>
          <span class="text-sm font-medium text-gray-500 uppercase tracking-widest">Pédagogique</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <span class="text-2xl">🛡️</span>
          <span class="text-sm font-medium text-gray-500 uppercase tracking-widest">Indépendant</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <span class="text-2xl">🇷🇪</span>
          <span class="text-sm font-medium text-gray-500 uppercase tracking-widest">Basé à La Réunion</span>
        </div>
      </div>
    </div>
  </div>
</section>
