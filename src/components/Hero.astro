---
// Hero ZANGOUN
---

<section class="relative min-h-[92vh] flex items-center justify-center overflow-hidden bg-volkano-dark">
  <!-- Background grid -->
  <div class="absolute inset-0 bg-grid-pattern-dark opacity-20"></div>

  <!-- Blue glow top-left -->
  <div class="absolute -top-32 -left-32 w-[600px] h-[600px] rounded-full pointer-events-none" style="background: radial-gradient(ellipse, rgba(52,162,237,0.12) 0%, transparent 70%);"></div>
  <!-- Fire glow top-right -->
  <div class="absolute -top-20 right-1/4 w-[500px] h-[400px] rounded-full pointer-events-none" style="background: radial-gradient(ellipse, rgba(232,93,4,0.08) 0%, transparent 70%);"></div>
  <!-- Blue glow bottom-right -->
  <div class="absolute bottom-0 right-0 w-[400px] h-[400px] rounded-full pointer-events-none" style="background: radial-gradient(ellipse, rgba(52,162,237,0.08) 0%, transparent 70%);"></div>

  <div class="container relative z-10 mx-auto px-4">
    <div class="max-w-5xl mx-auto text-center">

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-semibold uppercase tracking-widest mb-10 border" style="background: rgba(52,162,237,0.08); border-color: rgba(52,162,237,0.25); color: #34A2ED;">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-volkano-blue opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-volkano-blue"></span>
        </span>
        Laboratoire technologique indépendant
      </div>

      <!-- Headline -->
      <h1 class="font-display font-bold text-5xl md:text-7xl lg:text-8xl text-white leading-[1.05] tracking-tight mb-8">
        Comprendre la<br />
        <span style="background: linear-gradient(135deg, #34A2ED 0%, #FFBA08 50%, #E85D04 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
          technologie
        </span><br />
        pour agir.
      </h1>

      <!-- Subheadline -->
      <p class="text-xl md:text-2xl text-gray-400 max-w-3xl mx-auto mb-12 leading-relaxed">
        IA, blockchain et automatisation expliquées simplement<br class="hidden md:block" />
        et transformées en <span class="text-white font-medium">outils utiles</span>.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
        <a href="/outils" class="btn-primary text-base px-8 py-4">
          <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
          Explorer les outils
        </a>
        <a href="/guides" class="inline-flex items-center px-8 py-4 text-base font-semibold text-gray-300 border border-white/15 rounded-full hover:border-white/30 hover:text-white transition-all duration-300 hover:bg-white/5">
          Voir les guides
          <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Stats / trust indicators -->
      <div class="flex flex-wrap justify-center gap-8 text-center">
        {[
          { num: '5', label: 'Outils interactifs', icon: '🔬' },
          { num: '3', label: 'Piliers tech', icon: '⚡' },
          { num: '100%', label: 'Indépendant', icon: '🛡️' },
        ].map(stat => (
          <div class="flex flex-col items-center gap-2">
            <div class="w-12 h-12 rounded-full flex items-center justify-center text-xl" style="background: rgba(52,162,237,0.08); border: 1px solid rgba(52,162,237,0.2);">
              {stat.icon}
            </div>
            <div class="font-display font-bold text-2xl text-white">{stat.num}</div>
            <div class="text-xs text-gray-500 uppercase tracking-wider">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40">
    <span class="text-xs text-gray-500 uppercase tracking-widest">Découvrir</span>
    <div class="w-5 h-8 border border-gray-600 rounded-full flex justify-center pt-2">
      <div class="w-1 h-2 bg-volkano-blue rounded-full animate-bounce"></div>
    </div>
  </div>
</section>
