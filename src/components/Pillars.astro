---
const pillars = [
  {
    icon: '🔍',
    title: 'Décrypter',
    description: 'Analyser et vulgariser les tendances tech, crypto et IA pour comprendre leurs enjeux réels.',
    color: 'bg-volkano-orange/10 text-volkano-orange',
  },
  {
    icon: '🏗️',
    title: 'Structurer',
    description: 'Organiser l\'information et créer des frameworks actionnables pour passer de la théorie à la pratique.',
    color: 'bg-volkano-blue/10 text-volkano-blue',
  },
  {
    icon: '⚡',
    title: 'Expérimenter',
    description: 'Développer des outils concrets et des simulateurs pour tester et valider vos hypothèses.',
    color: 'bg-volkano-dark/10 text-volkano-dark',
  },
];
---

<section class="py-24 bg-gray-50/50 border-y border-gray-100">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16 max-w-2xl mx-auto">
      <h2 class="font-display font-bold text-3xl md:text-4xl text-volkano-dark mb-4">
        Notre approche
      </h2>
      <p class="text-lg text-gray-600">
        Trois piliers pour transformer la complexité en opportunité stratégique.
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {pillars.map((pillar) => (
        <div class="group bg-white rounded-3xl border border-gray-100 p-8 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
          <div class={`w-14 h-14 ${pillar.color} rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform`}>
            <span class="text-2xl">{pillar.icon}</span>
          </div>
          
          <h3 class="font-display font-bold text-xl text-volkano-dark mb-4 transition-colors">
            {pillar.title}
          </h3>
          
          <p class="text-gray-600 leading-relaxed">
            {pillar.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
