---
interface Props {
  tldr: string[];
  impact: string;
  risks?: string;
  checklist?: string[];
}

const { tldr, impact, risks, checklist = [] } = Astro.props;
---

<div class="my-16 space-y-8 animate-fade-in">
  <!-- TL;DR & Impact -->
  <div class="bg-gray-50 rounded-[2rem] p-8 md:p-10 border border-gray-100">
    <div class="flex items-center gap-3 mb-6">
      <span class="text-2xl">🔎</span>
      <h2 class="font-display font-bold text-2xl text-volkano-dark m-0">Cadre de lecture</h2>
    </div>
    
    <div class="grid md:grid-cols-2 gap-10">
      <div>
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-gray-400 mb-4">L'essentiel (TL;DR)</h3>
        <ul class="space-y-3 m-0 p-0 list-none">
          {tldr.map(item => (
            <li class="flex items-start gap-3 text-gray-700">
              <span class="text-volkano-orange font-bold mt-1">•</span>
              <span class="leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      
      <div class="space-y-8">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-gray-400 mb-4">Impact concret</h3>
          <p class="text-gray-700 leading-relaxed m-0">{impact}</p>
        </div>
        
        {risks && (
          <div>
            <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-gray-400 mb-4">Risques & Conformité</h3>
            <p class="text-gray-700 leading-relaxed m-0">{risks}</p>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Checklist -->
  {checklist.length > 0 && (
    <div class="bg-volkano-blue/5 rounded-[2rem] p-8 md:p-10 border border-volkano-blue/10">
      <h3 class="font-display font-bold text-xl text-volkano-dark mb-6 flex items-center gap-2">
        <span class="text-xl">✅</span> Checklist action
      </h3>
      <div class="grid sm:grid-cols-2 gap-4">
        {checklist.map(item => (
          <div class="flex items-center gap-3 p-4 bg-white rounded-2xl border border-volkano-blue/10 shadow-sm">
            <div class="w-5 h-5 rounded-md border-2 border-volkano-blue flex-shrink-0"></div>
            <span class="text-sm font-medium text-gray-700">{item}</span>
          </div>
        ))}
      </div>
    </div>
  )}
</div>
