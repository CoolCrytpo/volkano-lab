---
import BaseLayout from './BaseLayout.astro';
import ReadingFrame from '../components/ReadingFrame.astro';
import Card from '../components/Card.astro';

interface Props {
  title: string;
  description: string;
  date: string;
  author?: string;
  image?: string;
  tags?: string[];
  readingTime?: string;
  tldr: string[];
  impact: string;
  risks?: string;
  checklist?: string[];
}

const {
  title,
  description,
  date,
  author = "Volkano Lab",
  image,
  tags = [],
  readingTime = "5 min",
  tldr = [],
  impact = "",
  risks,
  checklist = [],
} = Astro.props;

// Related articles (placeholder)
const relatedArticles = [
  {
    title: "L'IA générative en 2026",
    description: "Analyse approfondie des dernières avancées.",
    href: "/decrypter/ia-generative-2026",
    tags: ["IA"],
    date: "2026-02-14",
  },
  {
    title: "Automatiser sa veille tech",
    description: "Méthodologie pratique pour construire un système de veille.",
    href: "/decrypter/automatiser-veille-tech",
    tags: ["Automatisation"],
    date: "2026-02-09",
  },
];
---

<BaseLayout title={title} description={description} image={image}>
  <article class="py-20">
    <div class="container mx-auto px-4 max-w-4xl">
      <!-- Header -->
      <header class="mb-16">
        <div class="flex flex-wrap gap-2 mb-6">
          {tags.map((tag) => (
            <span class="px-3 py-1 bg-volkano-orange/10 text-volkano-orange text-xs font-bold uppercase tracking-widest rounded-full border border-volkano-orange/20">
              {tag}
            </span>
          ))}
        </div>
        
        <h1 class="font-display font-bold text-4xl md:text-6xl text-volkano-dark mb-8 tracking-tight">
          {title}
        </h1>
        
        <div class="flex items-center text-gray-500 text-sm gap-4 mb-10 pb-10 border-b border-gray-100">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-volkano-dark rounded-full flex items-center justify-center text-xs">🌋</div>
            <span class="font-medium text-volkano-dark">{author}</span>
          </div>
          <span>•</span>
          <time datetime={date}>
            {new Date(date).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span>•</span>
          <span class="flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {readingTime} de lecture
          </span>
        </div>
        
        {image && (
          <div class="aspect-video rounded-[2rem] overflow-hidden mb-12 shadow-2xl">
            <img src={image} alt={title} class="w-full h-full object-cover" />
          </div>
        )}
        
        <p class="text-xl md:text-2xl text-gray-600 leading-relaxed font-light italic">
          {description}
        </p>
      </header>
      
      <!-- Reading Frame -->
      <ReadingFrame
        tldr={tldr}
        impact={impact}
        risks={risks}
        checklist={checklist}
      />
      
      <!-- Article Content -->
      <div class="prose prose-lg prose-volkano max-w-none mb-20 prose-headings:font-display prose-headings:font-bold prose-a:text-volkano-orange prose-pre:rounded-2xl prose-img:rounded-2xl">
        <slot />
      </div>
      
      <!-- Article Footer -->
      <footer class="border-t border-gray-100 pt-16">
        <!-- Share -->
        <div class="mb-20">
          <h3 class="font-display font-bold text-2xl text-volkano-dark mb-6">
            Partager cet article
          </h3>
          <div class="flex flex-wrap gap-4">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-6 py-3 bg-gray-50 hover:bg-volkano-dark hover:text-white transition-all rounded-full text-sm font-bold uppercase tracking-widest"
            >
              X (Twitter)
            </a>
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-6 py-3 bg-gray-50 hover:bg-volkano-dark hover:text-white transition-all rounded-full text-sm font-bold uppercase tracking-widest"
            >
              LinkedIn
            </a>
          </div>
        </div>
        
        <!-- Related Articles -->
        <div>
          <div class="flex items-end justify-between mb-10">
            <h3 class="font-display font-bold text-3xl text-volkano-dark">
              Articles liés
            </h3>
            <a href="/decrypter" class="text-volkano-orange font-bold text-sm hover:underline">Voir tout →</a>
          </div>
          <div class="grid md:grid-cols-2 gap-8">
            {relatedArticles.map((article) => (
              <Card {...article} />
            ))}
          </div>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>
