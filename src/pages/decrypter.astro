---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';

// Temporary static data - will be replaced with content collections
const articles = [
  {
    title: "L'IA générative en 2026 : opportunités et risques",
    description: "Analyse approfondie des dernières avancées en IA générative et leurs implications pour les entrepreneurs.",
    href: "/decrypter/ia-generative-2026",
    image: "/images/articles/ia-2026.svg",
    tags: ["IA", "Stratégie"],
    date: "2026-02-15",
  },
  {
    title: "Automatiser sa veille tech sans se perdre",
    description: "Méthodologie pratique pour construire un système de veille efficace avec les bons outils.",
    href: "/decrypter/automatiser-veille-tech",
    image: "/images/articles/veille-tech.svg",
    tags: ["Automatisation", "Outils"],
    date: "2026-02-10",
  },
  {
    title: "Crypto et conformité en France : guide 2026",
    description: "Comprendre le cadre légal français pour utiliser et investir dans les cryptomonnaies en toute sécurité.",
    href: "/decrypter/crypto-conformite-france",
    image: "/images/articles/crypto-legal.svg",
    tags: ["Crypto", "Conformité"],
    date: "2026-02-05",
  },
];

const categories = ["Tous", "IA", "Crypto", "Automatisation", "Outils", "Stratégie"];
---

<BaseLayout
  title="Décrypter"
  description="Articles de décryptage et d'analyse sur l'IA, la crypto, l'automatisation et les outils numériques."
>
  <div class="py-20">
    <div class="container mx-auto px-4">
      <!-- Header -->
      <div class="text-center mb-16">
        <div class="inline-flex items-center px-4 py-2 bg-volkano-orange/10 text-volkano-orange rounded-full text-sm font-medium mb-6">
          <span class="mr-2">🧠</span>
          Blog
        </div>
        <h1 class="font-display font-bold text-4xl md:text-5xl text-volkano-dark mb-6">
          Décrypter
        </h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Analyses, décryptages et guides pratiques sur les technologies qui transforment nos pratiques
        </p>
      </div>
      
      <!-- Filters -->
      <div class="mb-12">
        <div class="flex flex-wrap justify-center gap-3 mb-8">
          {categories.map((category) => (
            <button
              class={`px-4 py-2 rounded-lg font-medium transition-colors ${
                category === "Tous"
                  ? "bg-volkano-orange text-white"
                  : "bg-white border border-gray-200 text-gray-700 hover:border-volkano-orange hover:text-volkano-orange"
              }`}
              data-category={category}
            >
              {category}
            </button>
          ))}
        </div>
        
        <!-- Search Bar -->
        <div class="max-w-xl mx-auto">
          <div class="relative">
            <input
              type="text"
              id="search-input"
              placeholder="Rechercher un article..."
              class="w-full px-4 py-3 pl-12 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-volkano-orange focus:border-transparent"
            />
            <svg
              class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>
      </div>
      
      <!-- Articles Grid -->
      <div id="articles-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        {articles.map((article) => (
          <Card {...article} />
        ))}
      </div>
      
      <!-- Pagination -->
      <div class="flex justify-center items-center space-x-4">
        <button class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:border-volkano-orange hover:text-volkano-orange transition-colors disabled:opacity-50 disabled:cursor-not-allowed" disabled>
          Précédent
        </button>
        <span class="text-gray-600">Page 1 sur 1</span>
        <button class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:border-volkano-orange hover:text-volkano-orange transition-colors disabled:opacity-50 disabled:cursor-not-allowed" disabled>
          Suivant
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Simple client-side search functionality
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const articlesGrid = document.getElementById('articles-grid');
  
  searchInput?.addEventListener('input', (e) => {
    const searchTerm = (e.target as HTMLInputElement).value.toLowerCase();
    const articles = articlesGrid?.querySelectorAll('article');
    
    articles?.forEach((article) => {
      const text = article.textContent?.toLowerCase() || '';
      if (text.includes(searchTerm)) {
        article.classList.remove('hidden');
      } else {
        article.classList.add('hidden');
      }
    });
  });
  
  // Category filtering
  const categoryButtons = document.querySelectorAll('[data-category]');
  categoryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const category = button.getAttribute('data-category');
      
      // Update active button
      categoryButtons.forEach((btn) => {
        btn.classList.remove('bg-volkano-orange', 'text-white');
        btn.classList.add('bg-white', 'border', 'border-gray-200', 'text-gray-700');
      });
      button.classList.add('bg-volkano-orange', 'text-white');
      button.classList.remove('bg-white', 'border', 'border-gray-200', 'text-gray-700');
      
      // Filter articles (placeholder - will be implemented with real data)
      console.log('Filter by category:', category);
    });
  });
</script>
