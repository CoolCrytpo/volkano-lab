---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';

// Temporary static data - will be replaced with content collections
const tools = [
  {
    title: "Simulateur ROI IA",
    description: "Calculez le retour sur investissement potentiel de l'intégration d'outils IA dans votre activité.",
    href: "/outils/simulateur-roi-ia",
    image: "/images/tools/roi-ia.svg",
    tags: ["IA", "Simulateur"],
    premium: false,
  },
  {
    title: "Template Stratégie Crypto",
    description: "Framework complet pour structurer votre approche d'investissement crypto de manière rationnelle.",
    href: "/outils/template-strategie-crypto",
    image: "/images/tools/crypto-strategy.svg",
    tags: ["Crypto", "Template"],
    premium: true,
  },
  {
    title: "Checklist Automatisation",
    description: "Identifiez les processus automatisables dans votre activité et priorisez vos actions.",
    href: "/outils/checklist-automatisation",
    image: "/images/tools/automation.svg",
    tags: ["Automatisation", "Template"],
    premium: false,
  },
];

const filters = {
  type: ["Tous", "Gratuit", "Premium"],
  category: ["Tous", "IA", "Crypto", "Template", "Simulateur"],
};
---

<BaseLayout
  title="Boîte à outils"
  description="Outils, templates et simulateurs pour passer de la théorie à la pratique en IA, crypto et automatisation."
>
  <div class="py-20">
    <div class="container mx-auto px-4">
      <!-- Header -->
      <div class="text-center mb-16">
        <div class="inline-flex items-center px-4 py-2 bg-volkano-orange/10 text-volkano-orange rounded-full text-sm font-medium mb-6">
          <span class="mr-2">🧰</span>
          Outils
        </div>
        <h1 class="font-display font-bold text-4xl md:text-5xl text-volkano-dark mb-6">
          Boîte à outils
        </h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Des ressources concrètes pour passer de la théorie à la pratique
        </p>
      </div>
      
      <!-- Filters -->
      <div class="mb-12 space-y-6">
        <!-- Type Filter -->
        <div>
          <h3 class="font-display font-semibold text-sm text-gray-700 mb-3">Type</h3>
          <div class="flex flex-wrap gap-3">
            {filters.type.map((type) => (
              <button
                class={`px-4 py-2 rounded-lg font-medium transition-colors ${
                  type === "Tous"
                    ? "bg-volkano-orange text-white"
                    : "bg-white border border-gray-200 text-gray-700 hover:border-volkano-orange hover:text-volkano-orange"
                }`}
                data-filter-type={type}
              >
                {type}
              </button>
            ))}
          </div>
        </div>
        
        <!-- Category Filter -->
        <div>
          <h3 class="font-display font-semibold text-sm text-gray-700 mb-3">Catégorie</h3>
          <div class="flex flex-wrap gap-3">
            {filters.category.map((category) => (
              <button
                class={`px-4 py-2 rounded-lg font-medium transition-colors ${
                  category === "Tous"
                    ? "bg-volkano-blue text-white"
                    : "bg-white border border-gray-200 text-gray-700 hover:border-volkano-blue hover:text-volkano-blue"
                }`}
                data-filter-category={category}
              >
                {category}
              </button>
            ))}
          </div>
        </div>
      </div>
      
      <!-- Tools Grid -->
      <div id="tools-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        {tools.map((tool) => (
          <Card {...tool} />
        ))}
      </div>
      
      <!-- Empty State -->
      <div id="empty-state" class="hidden text-center py-16">
        <div class="text-6xl mb-4">🔍</div>
        <h3 class="font-display font-semibold text-xl text-volkano-dark mb-2">
          Aucun outil trouvé
        </h3>
        <p class="text-gray-600">
          Essayez de modifier vos filtres
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Filter functionality
  let currentTypeFilter = 'Tous';
  let currentCategoryFilter = 'Tous';
  
  const typeButtons = document.querySelectorAll('[data-filter-type]');
  const categoryButtons = document.querySelectorAll('[data-filter-category]');
  const toolsGrid = document.getElementById('tools-grid');
  const emptyState = document.getElementById('empty-state');
  
  function updateFilters() {
    const tools = toolsGrid?.querySelectorAll('article');
    let visibleCount = 0;
    
    tools?.forEach((tool) => {
      const isPremium = tool.querySelector('.bg-volkano-orange.text-white.text-xs') !== null;
      const tags = Array.from(tool.querySelectorAll('.bg-volkano-gray.text-gray-700.text-xs')).map(
        (tag) => tag.textContent?.trim() || ''
      );
      
      let showTool = true;
      
      // Type filter
      if (currentTypeFilter === 'Gratuit' && isPremium) showTool = false;
      if (currentTypeFilter === 'Premium' && !isPremium) showTool = false;
      
      // Category filter
      if (currentCategoryFilter !== 'Tous' && !tags.includes(currentCategoryFilter)) {
        showTool = false;
      }
      
      if (showTool) {
        tool.classList.remove('hidden');
        visibleCount++;
      } else {
        tool.classList.add('hidden');
      }
    });
    
    // Show/hide empty state
    if (visibleCount === 0) {
      emptyState?.classList.remove('hidden');
    } else {
      emptyState?.classList.add('hidden');
    }
  }
  
  typeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      currentTypeFilter = button.getAttribute('data-filter-type') || 'Tous';
      
      // Update active button
      typeButtons.forEach((btn) => {
        btn.classList.remove('bg-volkano-orange', 'text-white');
        btn.classList.add('bg-white', 'border', 'border-gray-200', 'text-gray-700');
      });
      button.classList.add('bg-volkano-orange', 'text-white');
      button.classList.remove('bg-white', 'border', 'border-gray-200', 'text-gray-700');
      
      updateFilters();
    });
  });
  
  categoryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      currentCategoryFilter = button.getAttribute('data-filter-category') || 'Tous';
      
      // Update active button
      categoryButtons.forEach((btn) => {
        btn.classList.remove('bg-volkano-blue', 'text-white');
        btn.classList.add('bg-white', 'border', 'border-gray-200', 'text-gray-700');
      });
      button.classList.add('bg-volkano-blue', 'text-white');
      button.classList.remove('bg-white', 'border', 'border-gray-200', 'text-gray-700');
      
      updateFilters();
    });
  });
</script>
