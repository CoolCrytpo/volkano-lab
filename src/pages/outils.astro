---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

// Chargement depuis Keystatic (src/content/tools/)
const toolEntries = await getCollection('tools');

// Tri par catégorie
const categories = [
  {
    id: 'gratuit',
    label: 'Ressources gratuites',
    icon: '🟢',
    description: 'Templates, guides et outils recommandés — 100% gratuits',
    subcategories: [
      { id: 'templates', label: 'Templates' },
      { id: 'guides', label: 'Guides pratiques' },
      { id: 'outils-recommandes', label: 'Outils recommandés' },
    ],
  },
  {
    id: 'premium',
    label: 'Ressources premium',
    icon: '🟠',
    description: 'eBooks, dossiers approfondis et méthodes détaillées',
    subcategories: [
      { id: 'ebooks', label: 'eBooks' },
      { id: 'dossiers', label: 'Dossiers premium' },
      { id: 'methodes', label: 'Méthodes détaillées' },
    ],
  },
  {
    id: 'services',
    label: 'Produits & services',
    icon: '🔵',
    description: 'Coaching, packs stratégiques et divertissement éducatif',
    subcategories: [
      { id: 'coaching', label: 'Coaching' },
      { id: 'packs', label: 'Packs stratégiques' },
      { id: 'divertissement', label: 'Divertissement éducatif' },
    ],
  },
];

// Adapter les entrées Keystatic au format Card
function toCardProps(entry: typeof toolEntries[0]) {
  const d = entry.data;
  return {
    title: d.title,
    description: d.description,
    href: `/outils/${d.slug}`,
    image: d.image ?? undefined,
    tags: d.tags ?? [],
    premium: d.premium ?? false,
    date: undefined,
    price: d.priceFiat ? `${d.priceFiat}€` : undefined,
  };
}
---

<BaseLayout
  title="Boîte à outils"
  description="Outils, templates, guides et services pour passer de la théorie à la pratique en IA, crypto et automatisation."
>
  <div class="py-20">
    <div class="container mx-auto px-4">

      <!-- Header -->
      <div class="text-center mb-20">
        <div class="section-label">
          <span class="mr-2">🧪</span>
          Boîte à outils
        </div>
        <h1 class="font-display font-bold text-4xl md:text-5xl text-volkano-dark mb-6">
          Ressources & Outils
        </h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Des ressources concrètes, organisées par besoin, pour passer de la théorie à l'action.
        </p>
      </div>

      <!-- Sections par catégorie -->
      {categories.map((cat) => {
        const catTools = toolEntries.filter(e => e.data.category === cat.id);

        return (
          <section class="mb-24" id={`cat-${cat.id}`}>
            <!-- En-tête de section -->
            <div class="flex items-start gap-4 mb-10 pb-6 border-b-2 border-gray-100">
              <div class={`text-3xl mt-1`}>{cat.icon}</div>
              <div>
                <h2 class="font-display font-bold text-2xl md:text-3xl text-volkano-dark mb-2">
                  {cat.label}
                </h2>
                <p class="text-gray-500 text-base">{cat.description}</p>
                <!-- Sous-catégories pills -->
                <div class="flex flex-wrap gap-2 mt-3">
                  {cat.subcategories.map(sub => (
                    <span class="px-3 py-1 bg-gray-100 text-gray-600 text-xs font-medium rounded-full">
                      {sub.label}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            {catTools.length > 0 ? (
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                {catTools.map(entry => (
                  <Card {...toCardProps(entry)} />
                ))}
              </div>
            ) : (
              <!-- Placeholder "Bientôt disponible" -->
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                {cat.subcategories.map(sub => (
                  <div class="group border-2 border-dashed border-gray-200 rounded-2xl p-8 flex flex-col items-center justify-center text-center hover:border-volkano-fire/40 transition-colors min-h-[200px]">
                    <div class="w-12 h-12 rounded-xl bg-gray-100 flex items-center justify-center mb-4">
                      <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                      </svg>
                    </div>
                    <p class="font-display font-semibold text-gray-500 mb-1">{sub.label}</p>
                    <p class="text-xs text-gray-400">Bientôt disponible</p>
                  </div>
                ))}
              </div>
            )}
          </section>
        );
      })}

    </div>
  </div>
</BaseLayout>
